{
  "entities": {
    "Tenant": {
      "title": "Tenant",
      "description": "Registered active or past tenant in the property",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "roomId": { "type": "number" },
        "name": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 30 },
        "email": { "type": "string", "maxLength": 100 },
        "identityNumber": { "type": "string", "maxLength": 30 },
        "occupation": { "type": "string", "maxLength": 50 },
        "checkInDate": { "type": "string", "maxLength": 20 },
        "contractDurationMonths": { "type": "number" },
        "emergencyContact": { "type": "object" },
        "notes": { "type": "string", "maxLength": 500 },
        "avatarUrl": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "roomId", "name", "phone", "identityNumber", "occupation", "checkInDate", "contractDurationMonths"]
    },
    "RentalBooking": {
      "title": "RentalBooking",
      "description": "Incoming rental applications and room survey inquiries",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "roomId": { "type": "number" },
        "roomNumber": { "type": "string", "maxLength": 30 },
        "roomType": { "type": "string", "maxLength": 50 },
        "name": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 30 },
        "occupation": { "type": "string", "maxLength": 50 },
        "targetMoveDate": { "type": "string", "maxLength": 20 },
        "durationMonths": { "type": "number" },
        "notes": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["pending", "survey_dijadwalkan", "disetujui", "ditolak", "selesai_checkin"] },
        "createdAt": { "type": "string", "maxLength": 30 }
      },
      "required": ["id", "roomId", "roomNumber", "name", "phone", "status", "createdAt"]
    },
    "Room": {
      "title": "Room",
      "description": "A rental room entity in the 8-room kos management system",
      "type": "object",
      "properties": {
        "id": { "type": "number", "description": "Unique numerical ID 1-8" },
        "roomNumber": { "type": "string", "maxLength": 30, "description": "Room display label e.g. Kamar 01" },
        "floor": { "type": "number", "description": "Floor number 1 or 2" },
        "type": { "type": "string", "enum": ["Deluxe AC", "Superior AC", "Standard Fan"] },
        "size": { "type": "string", "maxLength": 30, "description": "Room dimensions e.g. 3 x 4 m" },
        "basePrice": { "type": "number", "description": "Monthly base rental price in IDR" },
        "status": { "type": "string", "enum": ["terisi", "kosong", "perbaikan", "menunggu_pembayaran"] },
        "facilities": { "type": "array", "description": "List of room facilities" },
        "electricityType": { "type": "string", "enum": ["token_mandiri", "termasuk_sewa"] },
        "description": { "type": "string", "maxLength": 500, "description": "Room description and notes" }
      },
      "required": ["id", "roomNumber", "floor", "type", "basePrice", "status"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Monthly rent billing and payment records",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "invoiceNumber": { "type": "string", "maxLength": 64 },
        "roomId": { "type": "number" },
        "roomNumber": { "type": "string", "maxLength": 30 },
        "tenantName": { "type": "string", "maxLength": 100 },
        "tenantPhone": { "type": "string", "maxLength": 30 },
        "month": { "type": "string", "maxLength": 10 },
        "baseAmount": { "type": "number" },
        "additionalFees": { "type": "array" },
        "totalAmount": { "type": "number" },
        "dueDate": { "type": "string", "maxLength": 20 },
        "paidDate": { "type": "string", "maxLength": 20 },
        "status": { "type": "string", "enum": ["lunas", "belum_bayar", "menunggu_verifikasi", "ditolak"] },
        "paymentMethod": { "type": "string", "enum": ["qris", "transfer_bank", "tunai"] },
        "proofImageUrl": { "type": "string", "maxLength": 500000 },
        "qrisRef": { "type": "string", "maxLength": 64 },
        "verifiedAt": { "type": "string", "maxLength": 30 },
        "verifiedBy": { "type": "string", "maxLength": 100 },
        "notes": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "invoiceNumber", "roomId", "roomNumber", "tenantName", "month", "totalAmount", "dueDate", "status"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Operational and maintenance expense entry",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "date": { "type": "string", "maxLength": 20 },
        "month": { "type": "string", "maxLength": 10 },
        "category": { "type": "string", "enum": ["listrik", "air_pdam", "wifi_internet", "kebersihan_sampah", "maintenance_ac", "perbaikan_fasilitas", "gaji_pengelola", "lain_lain"] },
        "title": { "type": "string", "maxLength": 200 },
        "amount": { "type": "number" },
        "paidTo": { "type": "string", "maxLength": 100 },
        "notes": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "date", "month", "category", "title", "amount"]
    },
    "MaintenanceTicket": {
      "title": "MaintenanceTicket",
      "description": "Damage or facility repair ticket submitted by tenant or owner",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "ticketNumber": { "type": "string", "maxLength": 30 },
        "roomId": { "type": "number" },
        "roomNumber": { "type": "string", "maxLength": 30 },
        "tenantName": { "type": "string", "maxLength": 100 },
        "title": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 1000 },
        "category": { "type": "string", "enum": ["ac", "plumbing", "kelistrikan", "kebersihan", "kunci_pintu", "fasilitas_kamar", "lainnya"] },
        "priority": { "type": "string", "enum": ["rendah", "sedang", "tinggi", "darurat"] },
        "status": { "type": "string", "enum": ["menunggu", "diproses", "selesai"] },
        "createdAt": { "type": "string", "maxLength": 30 },
        "updatedAt": { "type": "string", "maxLength": 30 },
        "cost": { "type": "number" },
        "actionNotes": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "ticketNumber", "roomId", "roomNumber", "tenantName", "title", "category", "priority", "status", "createdAt"]
    },
    "KostSettings": {
      "title": "KostSettings",
      "description": "Property metadata, QRIS NMID, bank accounts, WiFi and house rules",
      "type": "object",
      "properties": {
        "kostName": { "type": "string", "maxLength": 100 },
        "tagline": { "type": "string", "maxLength": 150 },
        "address": { "type": "string", "maxLength": 250 },
        "city": { "type": "string", "maxLength": 100 },
        "ownerName": { "type": "string", "maxLength": 100 },
        "ownerPhone": { "type": "string", "maxLength": 30 },
        "ownerEmail": { "type": "string", "maxLength": 100 },
        "qrisNmid": { "type": "string", "maxLength": 50 },
        "qrisMerchantName": { "type": "string", "maxLength": 100 },
        "bankAccounts": { "type": "array" },
        "wifiSsid": { "type": "string", "maxLength": 50 },
        "wifiPass": { "type": "string", "maxLength": 50 },
        "rules": { "type": "array" },
        "paymentDueDay": { "type": "number" },
        "lateFeePerDay": { "type": "number" }
      },
      "required": ["kostName", "ownerName", "ownerPhone", "qrisNmid", "qrisMerchantName"]
    }
  },
  "firestore": {
    "/rooms/{roomId}": {
      "schema": { "$ref": "#/entities/Room" },
      "description": "Information and occupancy state of the 8 kos rooms"
    },
    "/tenants/{tenantId}": {
      "schema": { "$ref": "#/entities/Tenant" },
      "description": "Registered active and past tenants data"
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/RentalBooking" },
      "description": "Rental inquiries and room booking applications"
    },
    "/invoices/{invoiceId}": {
      "schema": { "$ref": "#/entities/Invoice" },
      "description": "Monthly rent and utility billing invoices with payment verification state"
    },
    "/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/Expense" },
      "description": "Operational and maintenance expenses for the property"
    },
    "/tickets/{ticketId}": {
      "schema": { "$ref": "#/entities/MaintenanceTicket" },
      "description": "Tenant maintenance requests and damage reports"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/KostSettings" },
      "description": "Property metadata, QRIS NMID, bank accounts, and rules"
    }
  }
}
